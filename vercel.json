{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "backend/server.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/backend/server.py"
    },
    {
      "src": "/docs",
      "dest": "/backend/server.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/backend/server.py"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}